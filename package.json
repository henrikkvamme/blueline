{
  "name": "@henrikkvamme/blueline",
  "version": "0.1.5",
  "description": "Review a web app in development with your coding agent: walk it in steps, compare a part's designs and annotate the page.",
  "keywords": [
    "coding-agent",
    "design",
    "mcp",
    "react",
    "review",
    "vite"
  ],
  "homepage": "https://github.com/henrikkvamme/blueline#readme",
  "bugs": "https://github.com/henrikkvamme/blueline/issues",
  "license": "MIT",
  "author": "Henrik Kvamme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henrikkvamme/blueline.git"
  },
  "bin": {
    "blueline": "./bin/blueline.ts"
  },
  "files": [
    "dist",
    "docs/manual.md"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.ts",
    "./choices": "./src/choices.ts",
    "./config": "./src/config/index.ts",
    "./variants": "./src/part/variants.tsx",
    "./vite": "./src/vite.ts",
    "./workshop": "./src/workshop/workshop.tsx",
    "./styles.css": "./src/styles.css"
  },
  "publishConfig": {
    "bin": {
      "blueline": "./dist/bin/blueline.js"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./react": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "./choices": {
        "types": "./dist/choices.d.ts",
        "default": "./dist/choices.js"
      },
      "./config": {
        "types": "./dist/config.d.ts",
        "default": "./dist/config.js"
      },
      "./variants": {
        "types": "./dist/variants.d.ts",
        "default": "./dist/variants.js"
      },
      "./vite": {
        "types": "./dist/vite.d.ts",
        "default": "./dist/vite.js"
      },
      "./workshop": {
        "types": "./dist/workshop.d.ts",
        "default": "./dist/workshop.js"
      },
      "./styles.css": "./dist/styles.css"
    }
  },
  "scripts": {
    "prepare": "effect-tsgo patch --typescript-package @typescript/native --oxlint",
    "check": "vp check && pnpm run typecheck && node scripts/overlay-css.ts --check",
    "css": "node scripts/overlay-css.ts",
    "typecheck": "node node_modules/@typescript/native/bin/tsc -p tsconfig.app.json && node node_modules/@typescript/native/bin/tsc -p tsconfig.node.json && node node_modules/@typescript/native/bin/tsc -p examples/review-demo",
    "test": "vp test run --project node --project browser-source",
    "test:packed": "vp test run --project browser-packed --project node-packed",
    "pack": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && vp pack",
    "verify": "pnpm run check && pnpm test && pnpm run pack && pnpm run test:packed",
    "demo": "pnpm --filter review-demo dev"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "@xstate/react": "6.1.0",
    "effect": "4.0.6",
    "lucide-react": "1.61.0",
    "typescript": "6.0.3",
    "xstate": "5.33.3"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.6",
    "@effect/tsgo": "0.56.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/oxide": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/browser-playwright": "5.0.5",
    "next": "16.4.3",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@12.15.0"
}
