{
  "name": "@henrikkvamme/blueline",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "blueline": "./bin/channel.ts"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./choices": "./src/choices.ts",
    "./variants": "./src/part/variants.tsx",
    "./vite": "./src/vite.ts",
    "./workshop": "./src/workshop/workshop.tsx",
    "./styles.css": "./src/styles.css"
  },
  "publishConfig": {
    "bin": {
      "blueline": "./dist/bin/channel.js"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./choices": {
        "types": "./dist/choices.d.ts",
        "default": "./dist/choices.js"
      },
      "./variants": {
        "types": "./dist/variants.d.ts",
        "default": "./dist/variants.js"
      },
      "./vite": {
        "types": "./dist/vite.d.ts",
        "default": "./dist/vite.js"
      },
      "./workshop": {
        "types": "./dist/workshop.d.ts",
        "default": "./dist/workshop.js"
      },
      "./styles.css": "./dist/styles.css"
    }
  },
  "scripts": {
    "prepare": "effect-tsgo patch --typescript-package @typescript/native --oxlint",
    "check": "vp check && pnpm run typecheck",
    "typecheck": "node node_modules/@typescript/native/bin/tsc -p tsconfig.app.json && node node_modules/@typescript/native/bin/tsc -p tsconfig.node.json",
    "test": "vp test run",
    "pack": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && vp pack",
    "verify": "pnpm run check && pnpm test && pnpm run pack"
  },
  "dependencies": {
    "@xstate/react": "6.1.0",
    "lucide-react": "1.61.0",
    "sonner": "2.0.8",
    "typescript": "6.0.3",
    "xstate": "5.33.3"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.6",
    "@effect/tsgo": "0.56.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "effect": "4.0.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "effect": "4.0.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3"
  },
  "packageManager": "pnpm@12.15.0"
}
